  ],
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "Run ID",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(agentsysperf_task_duration_seconds, run_id)",
        "refresh": 2,
        "sort": 2
      },
      {
        "name": "workload",
        "label": "Workload",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(agentsysperf_task_duration_seconds{run_id=\"$run_id\"}, workload)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
